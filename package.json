{
  "name": "artblog-php",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:site": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "serve": "php -d extension=pdo_sqlite -d extension=sqlite3 -S 127.0.0.1:8080 -t public public/router.php"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
