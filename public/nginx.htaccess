# Nginx rules (included into location / by phpStudy vhost)
# Static assets served directly, API/feed entries, SPA fallback.

location ^~ /assets/ {
    try_files $uri =404;
    expires 30d;
    access_log off;
}

location ^~ /uploads/ {
    try_files $uri =404;
    expires 7d;
    access_log off;
}

# Standalone entries
location = /sitemap.xml {
    rewrite ^ /sitemap.php last;
}

location = /rss.xml {
    rewrite ^ /rss.php last;
}

location = /api {
    rewrite ^ /api.php last;
}

location ^~ /api/ {
    rewrite ^/api/(.*)$ /api.php last;
}

# Page routes fall back to front controller
try_files $uri $uri/ /index.php?$query_string;
