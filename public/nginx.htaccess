# Nginx 路由规则（由 phpStudy vhost 的 include 引入到 location / 内）
# 生效范围：静态资源直出 + API/Feed 独立入口 + SPA 路由回退

# 静态资源：存在则直出，缺失就 404，禁止回退成 HTML
location ^~ /assets/ {
    try_files $uri =404;
    expires 30d;
    access_log off;
}

location ^~ /uploads/ {
    try_files $uri =404;
    expires 7d;
    access_log off;
}

# 独立入口
location = /sitemap.xml {
    rewrite ^ /sitemap.php last;
}

location = /rss.xml {
    rewrite ^ /rss.php last;
}

location = /api {
    rewrite ^ /api.php last;
}

location ^~ /api/ {
    rewrite ^/api/(.*)$ /api.php last;
}

# SPA / 页面路由回退到 front controller
try_files $uri $uri/ /index.php?$query_string;
